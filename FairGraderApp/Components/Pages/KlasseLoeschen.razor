@page "/schule/{schuleid}/klasse/loeschen/{klasseid}"
@inject FG_FairGrader FairGrader
@inject NavigationManager NavigationManager
@using FairGraderApp.Models

<PageTitle>Klasse löschen</PageTitle>

<h1>Klasse mit allen Schüler- Infos löschen?</h1>

<button type="button" class="btn border-0 bg-transparent p-1 mb-3" @onclick="OnCancel">
    <div class="d-flex align-items-center">
        <div class="me-2 p-1">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" aria-hidden="true" viewBox="0 0 16 16">
                <path fill-rule="evenodd" d="M15 8a.5.5 0 0 0-.5-.5H2.707l3.147-3.146a.5.5 0 1 0-.708-.708l-4 4a.5.5 0 0 0 0 .708l4 4a.5.5 0 0 0 .708-.708L2.707 8.5H14.5A.5.5 0 0 0 15 8" />
            </svg>
        </div>
        @(schule?.Name ?? "Zurück")
    </div>
</button>

@if (klasse is null || schule is null)
{
    <div class="alert alert-warning">Die angegebene Klasse wurde nicht gefunden.</div>
}
else
{
    <div class="card mb-3">
        <div class="card-body">
            <h5 class="card-title">@klasse.Name</h5>
            <p class="card-text">
                <strong>Schule:</strong> @schule.Name<br />
                <strong>Zug:</strong> @klasse.Zug<br />
                <strong>Stufe:</strong> @klasse.Stufe<br />
                <strong>Fach:</strong> @klasse.Fach<br />
                <strong>Anzahl Schüler:</strong> @klasse.Schueler.Count
            </p>
            
            @if (klasse.Schueler.Count > 0)
            {
                <div class="mt-3">
                    <strong>Schüler in dieser Klasse:</strong>
                    <ul class="list-unstyled mt-2">
                        @foreach (var schueler in klasse.Schueler.Take(5))
                        {
                            <li class="text-muted">• @schueler.Vorname @schueler.Name</li>
                        }
                        @if (klasse.Schueler.Count > 5)
                        {
                            <li class="text-muted">• ... und @(klasse.Schueler.Count - 5) weitere</li>
                        }
                    </ul>
                </div>
            }
        </div>
    </div>

    <div class="d-flex gap-2">
        <button type="button" class="btn btn-danger" @onclick="JetztLoeschen">Jetzt löschen</button>
    </div>
}

@code {
    [Parameter] public string? schuleid { get; set; }
    [Parameter] public string? klasseid { get; set; }

    private FG_Klasse? klasse;
    private FG_Schule? schule;

    protected override void OnParametersSet()
    {
        // Schule anhand der ID suchen
        schule = FairGrader.Schulen.FirstOrDefault(s => string.Equals(s.Id, schuleid, StringComparison.OrdinalIgnoreCase));
        
        // Klasse in der Schule suchen
        if (schule is not null)
        {
            klasse = schule.Klassen.FirstOrDefault(k => string.Equals(k.Id, klasseid, StringComparison.OrdinalIgnoreCase));
        }
    }

    private async Task JetztLoeschen()
    {
        if (klasse is not null && schule is not null && schuleid is not null && klasseid is not null)
        {
            // Klasse aus der Schule entfernen
            await FairGrader.DeleteKlasseAsync(schuleid, klasseid);
        }

        // Zurück zur Schule
        NavigationManager.NavigateTo($"schule/{schuleid}");
    }

    private void OnCancel()
    {
        // Zurück zur Schule
        NavigationManager.NavigateTo($"schule/{schuleid}");
    }
}