@page "/schulen/loeschen/{id}"
@inject FG_FairGrader FairGrader
@inject NavigationManager NavigationManager
@using FairGraderApp.Models

<PageTitle>Schule löschen</PageTitle>

<button type="button" class="btn border-0 bg-transparent p-1 mb-3" @onclick="OnCancel">
    <div class="d-flex align-items-center">
        <div class="me-2 p-1">
            <BackIcon />
        </div>
        Schulen
    </div>
</button>

<h1>Schule mit allen Klassen- Infos löschen?</h1>

@if (schule is null)
{
    <div class="alert alert-warning">Die angegebene Schule wurde nicht gefunden.</div>
}
else
{
    <div class="card mb-3">
        <div class="card-body">
            <h5 class="card-title">@schule.Name</h5>
            <p class="card-text">
                <strong>Adresse:</strong><br />
                @schule.Adresse
            </p>
            @* Hier könnten Klassen/Infos angezeigt werden, falls im Modell vorhanden *@
        </div>
    </div>

    <div class="d-flex gap-2">
        <button type="button" class="btn btn-danger" @onclick="JetztLoeschen">Jetzt löschen</button>
    </div>
}

@code {
    [Parameter] public string? id { get; set; }

    private FG_Schule? schule;

    protected override void OnParametersSet()
    {
        // Schule aus dem zentralen Modell anhand des Namens holen
        schule = FairGrader.Schulen.FirstOrDefault(s => string.Equals(s.Id, id, StringComparison.OrdinalIgnoreCase));
    }

    private async Task JetztLoeschen()
    {
        if (schule is not null)
        {
            await FairGrader.DeleteSchuleAsync(schule);
        }

        NavigationManager.NavigateTo("schulen");
    }

    private void OnCancel()
    {
        NavigationManager.NavigateTo("schulen");
    }
}
