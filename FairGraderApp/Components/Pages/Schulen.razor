@page "/"
@page "/schulen"
@inject FG_FairGrader FairGrader
@inject IJSRuntime JSRuntime
@inject NavigationManager NavigationManager
@using FairGraderApp.Models

<PageTitle>Schulen</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="mb-0">Schulen</h1>
    <button type="button"
            class="btn btn-primary d-flex flex-column justify-content-center text-center"
            style="height:4.5rem; width:7rem;"
            @onclick="@(() => NavigationManager.NavigateTo("schulen/neu"))">
        <span>Schule</span>
        <span>hinzufügen</span>
    </button>
</div>

@if (schulen is null) {
    <p>Lade Daten...</p>
}
else if (schulen.Count == 0) {
    <p>Keine Schulen vorhanden.</p>
}
else {
    <ul class="list-group">
        @foreach (var s in schulen) {
            <li class="list-group-item d-flex justify-content-between align-items-center"
                style="cursor: pointer;"
                @onclick="@(() => NavigationManager.NavigateTo($"schule/{s.Id}"))">
                <div class="me-2">
                    <span class="fw-semibold">@s.Name</span>
                    <small class="text-muted ms-2">@s.Adresse.Replace("\n", " | ")</small>
                    <small class="text-muted ms-2"> | @s.Klassen.Count Klassen</small>
                </div>
                <div class="d-flex gap-1">
                    <button type="button"
                            class="btn btn-outline-success btn-sm"
                            title="Bearbeiten"
                            @onclick:stopPropagation="true"
                            @onclick="@(() => NavigationManager.NavigateTo($"schulen/bearbeiten/{s.Id}"))">
                        <EditIcon />
                    </button>
                    <button type="button"
                            class="btn btn-outline-danger btn-sm"
                            title="Löschen"
                            @onclick:stopPropagation="true"
                            @onclick="@(() => NavigationManager.NavigateTo($"schulen/loeschen/{Uri.EscapeDataString(s.Id)}"))">
                        <DeleteIcon />
                    </button>
                </div>
            </li>
        }
    </ul>
}

@code {
    private List<FG_Schule>? schulen;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await FairGrader.EnsureLoadedFromBrowserStorageAsync(JSRuntime);
            schulen = FairGrader.GetSchulenSortiert();
            StateHasChanged();
        }
    }

    private async Task DeleteSchule(FG_Schule schule)
    {
        if (await FairGrader.DeleteSchuleAsync(schule))
        {
            schulen = FairGrader.GetSchulenSortiert();
            StateHasChanged();
        }
    }
}
