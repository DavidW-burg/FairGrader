@page "/schule/{schuleid}/klasse/bearbeiten/{klasseid}"
@inject NavigationManager NavigationManager
@inject FG_FairGrader FairGrader
@inject IJSRuntime JSRuntime
@using FairGraderApp.Models

<PageTitle>Klasse bearbeiten</PageTitle>

<h1>Klasse bearbeiten</h1>

<button type="button" class="btn border-0 bg-transparent p-1 mb-3" @onclick="OnCancel">
    <div class="d-flex align-items-center">
        <div class="me-2 p-1">
            <BackIcon />
        </div>
        @(schule?.Name ?? "Zurück")
    </div>
</button>

@if (schule is null || klasse is null)
{
    <div class="alert alert-warning">Die angegebene Klasse oder Schule wurde nicht gefunden.</div>
}
else
{
    <div class="mb-3">
        <label class="form-label">Schule: <strong>@schule.Name</strong></label>
    </div>

    <div class="row mb-3">
        <div class="col-md-4">
            <label for="klassenname" class="form-label">Klassenname</label>
            <input id="klassenname" class="form-control" @bind="Klassenname" />
        </div>
        <div class="col-md-4">
            <label for="stufe" class="form-label">Stufe</label>
            <input id="stufe" type="number" class="form-control" min="1" max="13" @bind="Stufe" />
        </div>
        <div class="col-md-4">
            <label for="zug" class="form-label">Zug</label>
            <input id="zug" class="form-control" @bind="Zug" maxlength="1" />
        </div>
    </div>

    <div class="mb-3">
        <label for="fach" class="form-label">Fach</label>
        <input id="fach" class="form-control" @bind="Fach" />
    </div>

    <div class="d-flex gap-2">
        <button type="button" class="btn btn-primary" @onclick="OnOk">Speichern</button>
    </div>
}

@code {
    [Parameter] public string? schuleid { get; set; }
    [Parameter] public string? klasseid { get; set; }

    private FG_Schule? schule;
    private FG_Klasse? klasse;
    private string Klassenname { get; set; } = string.Empty;
    private int Stufe { get; set; } = 1;
    private string Zug { get; set; } = string.Empty;
    private string Fach { get; set; } = string.Empty;

    protected override void OnParametersSet()
    {
        // Schule anhand der ID suchen
        schule = FairGrader.Schulen.FirstOrDefault(s => string.Equals(s.Id, schuleid, StringComparison.OrdinalIgnoreCase));

        // Klasse in der Schule suchen
        if (schule is not null)
        {
            klasse = schule.Klassen.FirstOrDefault(k => string.Equals(k.Id, klasseid, StringComparison.OrdinalIgnoreCase));

            // Vorhandene Werte in die Eingabefelder laden
            if (klasse is not null)
            {
                Klassenname = klasse.Name;
                Stufe = klasse.Stufe;
                Zug = klasse.Zug;
                Fach = klasse.Fach;
            }
        }
    }

    private async Task OnOk()
    {
        if (schule is not null && klasse is not null)
        {
            // Null-Check für schuleid und klasseid, um CS8604 zu vermeiden
            if (schuleid is not null && klasseid is not null) {
                await FairGrader.UpdateKlasseAsync(schuleid, 
                                                   klasseid, 
                                                   Klassenname.Trim(), 
                                                   Zug.Trim(), 
                                                   Stufe, 
                                                   Fach.Trim());
                // Zurück zur Schule
                NavigationManager.NavigateTo($"schule/{schuleid}");
            }
            else {
                await JSRuntime.InvokeVoidAsync("alert", "Fehler: Schule oder Klasse nicht gefunden.");
            }
        }

    }

    private void OnCancel()
    {
        // Zurück zur Schule
        NavigationManager.NavigateTo($"schule/{schuleid}");
    }
}
