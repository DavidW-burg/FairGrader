@page "/schulen/bearbeiten/{id}"
@inject FG_FairGrader FairGrader
@inject NavigationManager NavigationManager
@using FairGraderApp.Models

<PageTitle>Schule bearbeiten</PageTitle>

    <button type="button" class="btn border-0 bg-transparent p-1 mb-3" @onclick="OnCancel">
        <div class="d-flex align-items-center">
            <div class="me-2 p-1">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" aria-hidden="true" viewBox="0 0 16 16">
                    <path fill-rule="evenodd" d="M15 8a.5.5 0 0 0-.5-.5H2.707l3.147-3.146a.5.5 0 1 0-.708-.708l-4 4a.5.5 0 0 0 0 .708l4 4a.5.5 0 0 0 .708-.708L2.707 8.5H14.5A.5.5 0 0 0 15 8" />
                </svg>
            </div>
            Schulen
        </div>
    </button>

<h1>Schule bearbeiten</h1>

@if (schule is null) {
    <div class="alert alert-warning">Die angegebene Schule wurde nicht gefunden.</div>
}
else
{
    <div class="mb-3">
        <label for="schulname" class="form-label">Schulname</label>
        <input id="schulname" class="form-control" @bind="Schulname" />
    </div>

    <div class="mb-3">
        <label for="adresse" class="form-label">Adresse</label>
        <textarea id="adresse" class="form-control" rows="2" @bind="Adresse"></textarea>
    </div>

    <div class="d-flex gap-2">
        <button type="button" class="btn btn-primary" @onclick="OnOk">Speichern</button>
    </div>
}

@code {
    [Parameter] public string? id { get; set; }

    private FG_Schule? schule;
    private string Schulname { get; set; } = string.Empty;
    private string Adresse { get; set; } = string.Empty;

    protected override void OnParametersSet()
    {
        // Schule aus dem zentralen Modell anhand der ID holen
        schule = FairGrader.Schulen.FirstOrDefault(s => string.Equals(s.Id, id, StringComparison.OrdinalIgnoreCase));
        
        if (schule is not null)
        {
            // Aktuelle Werte in die Eingabefelder laden
            Schulname = schule.Name;
            Adresse = schule.Adresse;
        }
    }

    private async Task OnOk()
    {
        if (schule is not null)
        {
            // Daten des Objekts aktualisieren
            await FairGrader.UpdateSchuleAsync(schule, Schulname.Trim(), Adresse.Trim());
        }

        NavigationManager.NavigateTo("/schulen");
    }

    private void OnCancel()
    {
        NavigationManager.NavigateTo("/schulen");
    }
}