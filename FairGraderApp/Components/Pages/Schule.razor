@page "/schule/{id}"
@inject FG_FairGrader FairGrader
@inject NavigationManager NavigationManager
@using FairGraderApp.Models

<PageTitle>@(schule?.Name ?? "Schule")</PageTitle>

<button type="button" class="btn border-0 bg-transparent p-1 mb-3" @onclick="BackToSchools">
    <div class="d-flex align-items-center">
        <div class="me-2 p-1">
            <BackIcon />
        </div>
        Alle Schulen
    </div>
</button>

@if (schule is null) {
    <h1>Schule nicht gefunden</h1>
    <div class="alert alert-warning">Die angegebene Schule wurde nicht gefunden.</div>
}
else
{
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h1 class="mb-0">@schule.Name</h1>
        <button type="button"
                class="btn btn-primary d-flex flex-column justify-content-center text-center"
                style="height:3.5rem; width:7rem;"
                @onclick="NewClass">
            <span>Klasse</span>
            <span>hinzufügen</span>
        </button>
    </div>

    @if (schule.Klassen.Count == 0)
    {
        <p>Keine Klassen vorhanden.</p>
    }
    else
    {
        <ul class="list-group">
            @foreach (var klasse in schule.Klassen)
            {
                <li class="list-group-item d-flex justify-content-between align-items-center"
                    style="cursor: pointer;"
                    @onclick="@(() => NavigationManager.NavigateTo($"schule/{id}/klasse/{klasse.Id}"))">
                    <div class="me-2">
                        <span class="fw-semibold">@(string.IsNullOrWhiteSpace(klasse.Name) ? $"{klasse.Stufe}{klasse.Zug}" : klasse.Name)</span>
                        <small class="text-muted ms-2">@klasse.Fach ,</small>
                        <small class="text-muted ms-2">@klasse.Schueler.Count Schüler</small>
                    </div>
                    <div class="d-flex gap-1">
                        <button type="button"
                                class="btn btn-outline-success btn-sm"
                                title="Klasse bearbeiten"
                                @onclick:stopPropagation="true"
                                @onclick="@(() => KlasseBearbeiten(klasse))">
                            <EditIcon />
                        </button>
                        <button type="button"
                                class="btn btn-outline-danger btn-sm"
                                title="Klasse löschen"
                                @onclick:stopPropagation="true"
                                @onclick="@(() => KlasseLoeschen(klasse))">
                            <DeleteIcon />
                        </button>
                    </div>
                </li>
            }
        </ul>
    }
}

@code {
    [Parameter] public string? id { get; set; }

    private FG_Schule? schule;

    protected override void OnParametersSet()
    {
        // Schule aus dem zentralen Modell anhand der ID holen
        schule = FairGrader.Schulen.FirstOrDefault(s => string.Equals(s.Id, id, StringComparison.OrdinalIgnoreCase));
    }

    private void NewClass()
    {
        // Navigation zu Klasse-Neu
         NavigationManager.NavigateTo($"schule/{id}/klasse/neu");
    }

    private void KlasseBearbeiten(FG_Klasse klasse)
    {
        // Navigation zu Klasse bearbeiten
        NavigationManager.NavigateTo($"schule/{id}/klasse/bearbeiten/{klasse.Id}");
    }

    private void KlasseLoeschen(FG_Klasse klasse)
    {
        // Navigation zu Klasse löschen
        NavigationManager.NavigateTo($"schule/{id}/klasse/loeschen/{klasse.Id}");
    }

    private void BackToSchools()
    {
        NavigationManager.NavigateTo("schulen");
    }
}
