@page "/schule/{schuleid}/klasse/{klasseid}"
@inject FG_FairGrader FairGrader
@inject NavigationManager NavigationManager
@using FairGraderApp.Models

<PageTitle>Klasse</PageTitle>

<button type="button" class="btn border-0 bg-transparent p-1 mb-3" @onclick="BackToSchule">
    <div class="d-flex align-items-center">
        <div class="me-2 p-2">
            <BackIcon />
        </div>
        @(schule?.Name ?? "Zurück")
    </div>
</button>

@if (klasse is null || schule is null)
{
    <h1>Klasse nicht gefunden</h1>
    <div class="alert alert-warning">Die angegebene Klasse wurde nicht gefunden.</div>
    <button type="button" class="btn btn-secondary" @onclick="BackToSchools">Zurück zu Schulen</button>
}
else
{
    <div class="d-flex justify-content-between align-items-center mb-3">
        @if (klasse.Name != "") 
        { <h1>@klasse.Name - @klasse.Stufe@klasse.Zug</h1> }
        else 
        { <h1>@klasse.Stufe@klasse.Zug</h1> }
        <button type="button"
                class="btn btn-primary ms-2 d-flex flex-column justify-content-center text-center"
                style="height:3.5rem; min-width:7rem;"
                title="Schüler hinzufügen"
                @onclick="NewStudent">
            <span>Schüler</span>
            <span>hinzufügen</span>
        </button>
    </div>   

    <div class="mb-3 d-flex align-items-center">
        <button type="button"
                class="btn btn-success flex-grow-1 text-start d-flex align-items-center"
                style="height:4.5rem;"
                title="FairGrade"
                @onclick="OnFairGrade">
            FairGrade
        </button>
    </div>

    @if (klasse.Schueler.Count == 0)
    {
        <p>Keine Schüler vorhanden.</p>
    }
    else
    {
        <SortableList Class="mb-0"
                      TItem="FG_Schueler"
                      Data="klasse.Schueler"
                      Context="schueler"
                      OnUpdate="@OnSchuelerListUpdate">
              <ItemTemplate>
<!--                <li class="list-group-item d-flex justify-content-between align-items-center" -->
                <li class="d-flex justify-content-between align-items-center"
                    style="cursor: pointer;"
                    @onclick="@(() => NavigationManager.NavigateTo($"schule/{schuleid}/klasse/{klasseid}/schueler/{schueler.Id}"))">

                    <div class="d-flex align-items-center">
                        <div>
                            <span class="fw-semibold">@schueler.Name, @schueler.Vorname</span>
                            <small class="text-muted ms-2">@GetGeschlechtDisplay(schueler.Geschlecht)</small>
                        </div>
                    </div>

                    <div class="d-flex gap-1 me-2">
                        <button type="button"
                                class="btn btn-outline-success btn-sm"
                                title="Schüler bearbeiten"
                                @onclick:stopPropagation="true"
                                @onclick="@(() => SchuelerBearbeiten(schueler))">
                            <EditIcon />
                        </button>
                        <button type="button"
                                class="btn btn-outline-danger btn-sm"
                                title="Schüler löschen"
                                @onclick:stopPropagation="true"
                                @onclick="@(() => SchuelerLoeschen(schueler))">
                            <DeleteIcon />
                        </button>
                    </div>
                </li>
            </ItemTemplate>
        </SortableList>
    }
}

@code {
    [Parameter] public string? schuleid { get; set; }
    [Parameter] public string? klasseid { get; set; }

    private FG_Klasse? klasse;
    private FG_Schule? schule;

    protected override void OnParametersSet()
    {
        // Schule anhand der ID suchen
        schule = FairGrader.Schulen.FirstOrDefault(s => string.Equals(s.Id, schuleid, StringComparison.OrdinalIgnoreCase));

        // Klasse in der Schule suchen
        if (schule is not null)
        {
            klasse = schule.Klassen.FirstOrDefault(k => string.Equals(k.Id, klasseid, StringComparison.OrdinalIgnoreCase));
        }
    }

    private string GetGeschlechtDisplay(FG_Geschlecht geschlecht)
    {
        return geschlecht switch
        {
            FG_Geschlecht.not_def => "nA",
            FG_Geschlecht.male => "männl.",
            FG_Geschlecht.female => "weibl.",
            _ => "nA"
        };
    }

    private void NewStudent()
    {
        NavigationManager.NavigateTo($"schule/{schuleid}/klasse/{klasseid}/schueler/neu");
    }

    private void SchuelerBearbeiten(FG_Schueler schueler)
    {
        NavigationManager.NavigateTo($"schule/{schuleid}/klasse/{klasseid}/schueler/bearbeiten/{schueler.Id}");
    }

    private void SchuelerLoeschen(FG_Schueler schueler)
    {
        NavigationManager.NavigateTo($"schule/{schuleid}/klasse/{klasseid}/schueler/loeschen/{schueler.Id}");
    }

    private void BackToSchule()
    {
        NavigationManager.NavigateTo($"schule/{schuleid}");
    }

    private void BackToSchools()
    {
        NavigationManager.NavigateTo("schulen");
    }

    private void OnFairGrade()
    {
        NavigationManager.NavigateTo($"schule/{schuleid}/klasse/{klasseid}/gradefair");
    }
    private void OnSchuelerListUpdate(SortableListEventArgs args)
    {
        if (klasse is not null) 
        {
            var schuelerToRemove = klasse.Schueler[args.OldIndex];
            klasse.Schueler.RemoveAt(args.OldIndex);

            if (args.NewIndex < klasse.Schueler.Count)
                klasse.Schueler.Insert(args.NewIndex, schuelerToRemove);
            else
                klasse.Schueler.Add(schuelerToRemove);

            klasse.SortList.Clear();
            foreach (var schueler in klasse.Schueler)
            {
                klasse.SortList.Add(schueler.Id);
            }
        
        }
    }
}
